# Configuration des alertes de surveillance Auris (SCRUM-176)
#
# À copier sur le VPS en /opt/auris/.env.monitoring, puis à renseigner :
#   sudo cp .env.monitoring.example /opt/auris/.env.monitoring
#   sudo chmod 600 /opt/auris/.env.monitoring
#   sudo nano /opt/auris/.env.monitoring
#
# Ce fichier contient un mot de passe : il doit rester en 600 root:root et ne
# jamais être commité. Le .gitignore l'exclut, mais la vigilance reste de mise.

# ─── Destinataire ───
# Adresse qui reçoit les alertes — typiquement celle de la personne d'astreinte.
# Plusieurs adresses possibles, séparées par des virgules sans espace.
ALERT_EMAIL_TO=alerte@exemple.fr

# Adresse affichée en expéditeur. Elle doit être identique à SMTP_USER :
# les relais authentifiés refusent d'expédier au nom d'une autre boîte.
ALERT_EMAIL_FROM=monitoring@aurishetic.fr

# ─── Serveur SMTP ───
# Le VPS n'héberge pas de serveur mail, et OVH bloque fréquemment le port 25
# en sortie : on passe par un relais authentifié en 587 (STARTTLS).
#
# On utilise la boîte incluse avec le domaine (MX Plan OVH), créée depuis
# l'espace client : Web Cloud → Emails → aurishetic.fr → Comptes de messagerie.
# Une boîte dédiée plutôt qu'une adresse personnelle : le mot de passe stocké
# ici ne donne alors accès qu'à une messagerie vide.
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_USER=monitoring@aurishetic.fr
SMTP_PASSWORD=mot-de-passe-de-la-boite

# ─── Comportement ───
# Délai de silence, en minutes, entre deux alertes pour un même service tant
# qu'il reste en panne. La première alerte part toujours immédiatement.
ALERT_COOLDOWN_MIN=60
