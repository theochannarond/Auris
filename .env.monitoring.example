# Configuration des alertes de surveillance Auris (SCRUM-176)
#
# À copier sur le VPS en /opt/auris/.env.monitoring, puis à renseigner :
#   sudo cp .env.monitoring.example /opt/auris/.env.monitoring
#   sudo chmod 600 /opt/auris/.env.monitoring
#   sudo nano /opt/auris/.env.monitoring
#
# Ce fichier contient un mot de passe : il doit rester en 600 root:root et ne
# jamais être commité. Le .gitignore l'exclut, mais la vigilance reste de mise.

# ─── Destinataire ───
# Adresse qui reçoit les alertes. Plusieurs adresses possibles, séparées par
# des virgules sans espace.
ALERT_EMAIL_TO=alerte@exemple.fr

# Adresse affichée en expéditeur. Avec Gmail, elle doit être identique à
# SMTP_USER, sinon le message est refusé.
ALERT_EMAIL_FROM=alerte@exemple.fr

# ─── Serveur SMTP ───
# Le VPS n'a pas de serveur mail local, et OVH bloque fréquemment le port 25
# en sortie : on passe donc par un relais authentifié en 587 (STARTTLS).
#
# Avec Gmail, SMTP_PASSWORD n'est PAS le mot de passe du compte mais un
# « mot de passe d'application », à générer sur
# https://myaccount.google.com/apppasswords (validation en deux étapes requise).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerte@exemple.fr
SMTP_PASSWORD=mot-de-passe-d-application

# ─── Comportement ───
# Délai de silence, en minutes, entre deux alertes pour un même service tant
# qu'il reste en panne. La première alerte part toujours immédiatement.
ALERT_COOLDOWN_MIN=60
