# À copier en infra/.env — et non à la racine : Docker Compose lit son .env
# dans le dossier du fichier de composition. Voir la section Installation
# du README.

# Base de données
# DATABASE_URL n'est utilisée QUE si vous lancez le backend hors conteneur :
# le compose reconstruit lui-même l'URL à partir des deux variables suivantes.
DATABASE_URL=postgresql://auris:your-postgres-password@localhost:5432/auris
POSTGRES_USER=auris
POSTGRES_PASSWORD=your-postgres-password

# Keycloak
# Nom du service Docker, pas localhost : c'est le backend, depuis l'intérieur
# du réseau Docker, qui appelle cette URL. Mettre localhost ne fonctionne que
# si vous lancez le backend directement sur votre machine.
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=auris
KEYCLOAK_CLIENT_ID=auris-backend
KEYCLOAK_CLIENT_SECRET=your-secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your-admin-password

# Mistral AI (Voxtral Mini V2 + Mistral Small 4)
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_API_URL=https://api.mistral.ai/v1
VOXTRAL_MODEL=voxtral-mini-latest
VOXTRAL_TIMEOUT_SEC=300

# OVH Object Storage
OVH_ACCESS_KEY=your-ovh-access-key
OVH_SECRET_KEY=your-ovh-secret-key
OVH_BUCKET_NAME=auris-audio

# Vexa
VEXA_API_KEY=your-vexa-api-key

# Frontend Keycloak
# Ces trois variables ne servent PAS au développement local : le compose ne les
# transmet pas au conteneur frontend, qui retombe sur ces mêmes valeurs par
# défaut. Elles ne comptent qu'à la construction de l'image de production, où
# elles sont figées dans le bundle (arguments de build, voir frontend/Dockerfile).
# En prod (derrière nginx) : doit être l'URL PUBLIQUE du domaine + /auth,
# jamais http://keycloak:8080 (injoignable depuis le navigateur de l'utilisateur)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=auris
VITE_KEYCLOAK_CLIENT_ID=auris-frontend

# Vexa Webhook
VEXA_WEBHOOK_SECRET=your-vexa-webhook-secret

# Retry Voxtral
MAX_RETRY_COUNT=3