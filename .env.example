# Base de données
DATABASE_URL=postgresql://user:password@localhost:5432/auris

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=auris
KEYCLOAK_CLIENT_ID=auris-backend
KEYCLOAK_CLIENT_SECRET=your-secret

# Mistral AI
MISTRAL_API_KEY=your-mistral-api-key

# Voxtral
VOXTRAL_API_KEY=your-voxtral-api-key

# OVH Object Storage
OVH_ACCESS_KEY=your-ovh-access-key
OVH_SECRET_KEY=your-ovh-secret-key
OVH_BUCKET_NAME=auris-audio

# Vexa
VEXA_API_KEY=your-vexa-api-key