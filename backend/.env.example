# ─── Base de données ───
DATABASE_URL=postgresql://auris:your-password@db:5432/auris

# ─── Keycloak ───
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=auris
KEYCLOAK_CLIENT_ID=auris-backend
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret

# ─── Mistral / Voxtral ───
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_API_URL=https://api.mistral.ai/v1
VOXTRAL_MODEL=voxtral-mini-latest
VOXTRAL_TIMEOUT_SEC=300
MAX_RETRY_COUNT=3

# ─── OVH Object Storage ───
OVH_ACCESS_KEY=your-ovh-access-key
OVH_SECRET_KEY=your-ovh-secret-key
OVH_BUCKET_NAME=auris-audio
OVH_ENDPOINT_URL=https://s3.gra.io.cloud.ovh.net
OVH_REGION=gra

# ─── Vexa ───
VEXA_API_KEY=your-vexa-api-key
VEXA_WEBHOOK_SECRET=your-vexa-webhook-secret

# ─── OVH Backup Storage ───
OVH_BACKUP_BUCKET=auris-backups